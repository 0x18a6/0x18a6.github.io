---
interface Props {
  label: string
  href: string
  class?: string
}

const { label, href, class: className } = Astro.props
---

<a
  href={href}
  class:list={["group inline-flex items-center gap-x-1.5", className]}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="text-muted-foreground group-hover:text-foreground"
    width="16"
    height="16"
  >
    <path
      d="m14 5-7 7 7 7"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"></path>
  </svg>
  <span>{label}</span>
</a>
