---
interface Props {
  type?: "tip" | "note" | "warning" | "caution" | "important"
  title?: string
}

const { type = "note", title } = Astro.props

const config = {
  tip: {
    icon: "lightbulb",
    label: "Tip",
  },
  note: {
    icon: "info",
    label: "Note",
  },
  warning: {
    icon: "warning",
    label: "Warning",
  },
  caution: {
    icon: "caution",
    label: "Caution",
  },
  important: {
    icon: "star",
    label: "Important",
  },
}

const { icon, label } = config[type]
const displayTitle = title ?? label
---

<div class={`callout-${type} my-4 border-l-4 py-1 pl-4`}>
  <div class="mb-1 flex items-center gap-2">
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-4 shrink-0 text-muted-foreground/80"
    >
      {
        icon === "lightbulb" && (
          <path
            fill="currentColor"
            d="M9 21h6v-1.5H9V21Zm3-19a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2Z"
          />
        )
      }
      {
        icon === "info" && (
          <path
            fill="currentColor"
            d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-6h2v6Zm0-8h-2V7h2v2Z"
          />
        )
      }
      {
        icon === "warning" && (
          <path
            fill="currentColor"
            d="M1.8 20 12 2.5 22.2 20H1.8Zm11.2-3v-2h-2v2h2Zm0-4V9h-2v4h2Z"
          />
        )
      }
      {
        icon === "caution" && (
          <path
            fill="currentColor"
            d="M12 2 4 5.5v5.2c0 5.1 3.4 9.8 8 11.3 4.6-1.5 8-6.2 8-11.3V5.5L12 2Zm1 15h-2v-2h2v2Zm0-4h-2V8h2v5Z"
          />
        )
      }
      {
        icon === "star" && (
          <path
            fill="currentColor"
            d="m12 2 2.9 6 6.6.9-4.8 4.7 1.1 6.6-5.8-3.1-5.8 3.1 1.1-6.6-4.8-4.7L9.1 8 12 2Z"
          />
        )
      }
    </svg>
    <span class="font-semibold text-foreground">{displayTitle}</span>
  </div>
  <div class="text-foreground">
    <slot />
  </div>
</div>

<style>
  .callout-tip {
    border-color: var(--color-tip);
  }
  .callout-note {
    border-color: var(--color-note);
  }
  .callout-warning {
    border-color: var(--color-warning);
  }
  .callout-caution {
    border-color: var(--color-caution);
  }
  .callout-important {
    border-color: var(--color-important);
  }
</style>
