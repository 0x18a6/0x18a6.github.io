---
import BaseLayout from "@layouts/BaseLayout.astro"
import Back from "@components/common/Back.astro"

const bookingUrl =
  "https://calendar.google.com/calendar/appointments/schedules/AcZssZ280bHT1sq5Bl-Bx8ELMoWPAgulZtkrVfNsWoWTUBuVcEOpD8ibQDGE57kO7RXx7DAtO3o7_lKj?gv=true"
---

<BaseLayout
  title="Book a meeting"
  description="Choose an available time to meet with 0x18a6."
>
  <section aria-labelledby="booking-heading">
    <Back
      label="Back to home"
      href="/"
      class="mb-8 text-sm text-muted-foreground transition-colors hover:text-foreground"
    />

    <header class="mb-6">
      <h1
        id="booking-heading"
        class="mb-2 text-3xl font-semibold tracking-tight"
      >
        Book a meeting
      </h1>
      <p class="text-muted-foreground">
        The invitation will include a Google
        Meet link.
      </p>
    </header>

    <div
      class="overflow-hidden rounded-lg border border-border bg-[var(--flexoki-paper)]"
    >
      <iframe
        src={bookingUrl}
        title="Book a meeting with 0x18a6"
        class="block h-[680px] w-full"
        loading="eager"
        frameborder="0"></iframe>
    </div>

    <p class="mt-3 text-sm text-muted-foreground">
      Or, open the <a
        href={bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-foreground underline decoration-muted-foreground/50 underline-offset-2 transition-colors hover:decoration-foreground"
        > booking page</a
      > in a new tab .
    </p>
  </section>
</BaseLayout>
